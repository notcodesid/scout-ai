# Spectrum credentials (from your Photon dashboard). Required.
PROJECT_ID=
PROJECT_SECRET=

# OpenRouter key: one key for all agents. Free tier works (50 requests/day).
# Get one at openrouter.ai — no credit card needed for free models.
OPENROUTER_API_KEY=

# Exa key: web search and page retrieval for the research agent and the funding radar.
EXA_API_KEY=

# Models. Defaults are free OpenRouter models; override only if you swap.
# Free tier (current defaults):
#   RESEARCH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#   REVIEWER_MODEL=thinkingmachines/inkling:free
# With ~$10 of credits loaded, stronger paid options:
#   RESEARCH_MODEL=openai/gpt-5.6-luna
#   REVIEWER_MODEL=google/gemini-3.1-pro-preview

# Interview agent runs on local Ollama (free, unlimited). Pull the model first:
#   ollama pull qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# SCOUT_MODEL=qwen2.5:3b

# Funding radar (`bun run radar`): news outlets to search, comma separated.
# Defaults to Indian startup outlets (see src/radar/contracts.ts).
# RADAR_DOMAINS=inc42.com,entrackr.com,yourstory.com
# Limits default to 12 articles of 5000 characters (fits a free model tier).
# RADAR_MAX_ARTICLES=32
# RADAR_ARTICLE_CHARS=12000
#
# Any OpenAI-compatible model endpoint works in place of OpenRouter, e.g. Gemini:
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENROUTER_API_KEY=<gemini key>
# RESEARCH_MODEL=gemini-2.5-flash

# Copy to .env and fill in. Bun loads .env by itself. Never commit real keys.

# --- iMessage agent (`bun start`) -------------------------------------------
# Spectrum credentials from the Photon dashboard (app.photon.codes). Required for `bun start` only.
PROJECT_ID=
PROJECT_SECRET=
# Interview agent: a local Ollama model (free, unlimited). Pull it first: ollama pull qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# SCOUT_MODEL=qwen2.5:3b

# --- Search (radar, hiring, contacts, daily, research) ------------------------
# Exa key: every web search and page read. Required by all four job-hunt commands.
EXA_API_KEY=

# --- Model (radar and research only; hiring and contacts use no model) --------
# Key for an OpenAI-compatible endpoint. OpenRouter by default (free tier: 50 requests/day).
OPENROUTER_API_KEY=
# Endpoint, if not OpenRouter. Gemini's OpenAI-compatible endpoint works with a Gemini key above:
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model that extracts funding rounds (radar) and writes research. Default: a free OpenRouter model.
# RESEARCH_MODEL=gemini-2.5-flash
# Model that reviews research claims; keep it a different family than RESEARCH_MODEL.
# REVIEWER_MODEL=

# --- Funding radar (`bun run radar`, first stage of `bun run daily`) ----------
# News sites searched, comma separated. Default: Indian startup outlets (src/radar/contracts.ts).
# RADAR_DOMAINS=inc42.com,entrackr.com,yourstory.com
# Only report new companies in these sectors (same as --sectors). Every round is stored either way.
# One or more of: software-ai, fintech, deeptech-hardware, healthcare-biotech, consumer-brand, gaming-media, climate-energy, other
# RADAR_SECTORS=software-ai,fintech
# Most articles sent to the model per run (default 30). Lower it on a tight free tier.
# RADAR_MAX_ARTICLES=30
# Characters kept from a single-story article (default 5000).
# RADAR_ARTICLE_CHARS=5000
# Characters kept from a weekly roundup, which lists many rounds (default 12000).
# RADAR_ROUNDUP_CHARS=12000
# Output token limit per model call (default 16000; reasoning models need the headroom).
# RADAR_MAX_TOKENS=16000
# Model call timeout in milliseconds (default 120000).
# RADAR_MODEL_TIMEOUT_MS=120000
# Minimum milliseconds between model calls (default 6000; free tiers allow few calls a minute).
# RADAR_CALL_GAP_MS=6000
# Reasoning effort passed to the model when set (e.g. low). Unset: the model's default.
# RADAR_REASONING_EFFORT=low
# Database file for radar companies and read articles (default .data/radar.db).
# RADAR_DB=.data/radar.db

# --- Hiring check (`bun run hiring`) ------------------------------------------
# Database file for hiring checks (default: the same .data/radar.db).
# HIRING_DB=.data/radar.db

# --- Contact finder (`bun run contacts`) --------------------------------------
# Optional Hunter key: Email Finder for named people, Verifier for --verify and guesses.
# HUNTER_API_KEY=
# Database file for contact lookups (default: the same .data/radar.db).
# CONTACTS_DB=.data/radar.db

# --- Daily digest (`bun run daily`, and the "jobs" text) ----------------------
# Your fit profile, used when no --roles/--sectors/--cities flag is given. Comma separated.
# Role keywords are matched against role titles; sectors use the radar's labels; cities only rank.
# SCOUT_ROLES=backend,full-stack,engineer
# SCOUT_SECTORS=software-ai,fintech
# SCOUT_CITIES=Bengaluru
# remote, hybrid or onsite. With hybrid or onsite, a matching city counts for more.
# SCOUT_WORK_MODE=remote

# Radar on Gemini's free tier (20 requests/day per model; a full 30-article run needs about 15):
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RESEARCH_MODEL=gemini-3.1-flash-lite   # or gemini-3.1-flash-lite-preview / gemini-flash-lite-latest when the quota is spent
# RADAR_REASONING_EFFORT=low
